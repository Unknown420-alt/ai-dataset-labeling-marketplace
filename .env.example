# AI Dataset Labeling Marketplace - Environment Template
# Copy to .env and fill in your values. Don't commit .env!

# Flask/FastAPI secret key - generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_me_to_real_secret

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/marketplace

# AI (optional for Week 1)
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Storage (local for now, S3 later)
UPLOAD_DIR=/tmp/uploads
