# Backend environment variables — copy to .env and update
SECRET_KEY=change-me-to-a-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/marketplace
# For local testing without Postgres:
# DATABASE_URL=sqlite+aiosqlite:///./marketplace.db
ENVIRONMENT=development
# LLM suggestions (optional, off by default — local model needs no key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Real OTP email (optional locally — without this, codes show in dev mode)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Vercel Postgres example (set these in the Vercel dashboard, not here):
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/marketplacedb?sslmode=require
# DIRECT_URL=postgresql://user:password@ep-xyz.neon.tech/marketplacedb?sslmode=require